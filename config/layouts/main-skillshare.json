              "id": "skillshare-panel",
              "type": "column",
              "children": [
                {
                  "id": "skillshare",
                  "type": "block",
                  "content": {
                    "mod": "skillshare"
                  }
                }
              ],
              "size": {
                "px": 400
              },
              "min": 380,
              "max": 720
            }
