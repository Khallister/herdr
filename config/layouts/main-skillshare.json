              },
              "min": 130,
              "content": {
                "mod": "usage-limits"
              }
            }
          ]
        }
      ],
      "resizable": false,
      "floating": [
        {
          "id": "attention",
          "content": {
            "mod": "attention"
          },
          "edge": "right",
          "align": "end",
          "peek": 40
        }
      ]
    }
