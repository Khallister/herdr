              "children": [
                {
                  "id": "panel-body",
                  "type": "stack",
                  "children": [
                    {
                      "id": "files",
                      "type": "block",
                      "content": {
                        "mod": "files"
                      }
                    },
                    {
                      "id": "changes",
                      "type": "block",
                      "content": {
                        "mod": "changes"
                      }
                    },
                    {
                      "id": "devservers",
                      "type": "block",
                      "content": {
                        "mod": "devservers"
                      }
                    },
                    {
                      "id": "project-notes",
                      "type": "block",
                      "content": {
                        "mod": "project-notes"
                      }
                    },
                    {
                      "id": "machines",
                      "type": "block",
                      "content": {
                        "mod": "machines"
                      }
                    }
